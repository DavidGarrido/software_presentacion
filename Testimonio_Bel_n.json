  "viewerHtml": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Testimonio de Belén</title>\n    <style>\n        * { margin:0; padding:0; box-sizing:border-box; }\n\n        body {\n            font-family:'Segoe UI', Arial, sans-serif;\n            background:#ffe4ec;\n            color:#5c2d41;\n            overflow:hidden;\n            height:100vh;\n        }\n\n        /* ── Partículas de fondo ── */\n        .particles {\n            position:fixed;\n            top:0; left:0; width:100%; height:100%;\n            pointer-events:none;\n            z-index:0;\n            overflow:hidden;\n        }\n        .particle {\n            position:absolute;\n            font-size:1.6rem;\n            opacity:0;\n            animation:rise linear infinite;\n        }\n        @keyframes rise {\n            0%   { transform:translateY(110vh) rotate(0deg); opacity:0.6; }\n            100% { transform:translateY(-10vh) rotate(360deg); opacity:0; }\n        }\n\n        /* ── Slides ── */\n        .slide-container {\n            position:relative;\n            width:100%;\n            height:100vh;\n        }\n\n        .slide {\n            position:absolute;\n            top:0; left:0;\n            width:100%; height:100%;\n            display:grid;\n            grid-template-rows:auto 1fr auto;\n            align-items:center;\n            justify-items:center;\n            padding:30px 60px;\n            opacity:0;\n            visibility:hidden;\n            transition:opacity 0.6s ease, transform 0.6s ease;\n            transform:translateX(40px);\n            z-index:2;\n        }\n\n        .slide.active {\n            opacity:1;\n            visibility:visible;\n            transform:translateX(0);\n        }\n\n        /* ── Fondo por slide ── */\n        .slide-bg {\n            position:absolute;\n            inset:0;\n            z-index:0;\n        }\n        .slide[data-slide=\"0\"] .slide-bg {\n            background:linear-gradient(145deg, #ff6ba8 0%, #ff1493 50%, #c71585 100%);\n        }\n        .slide[data-slide=\"1\"] .slide-bg { background:linear-gradient(145deg, #ffe4ec 0%, #ffc0d9 100%); }\n        .slide[data-slide=\"2\"] .slide-bg { background:linear-gradient(145deg, #fff0f5 0%, #ffb6d9 100%); }\n        .slide[data-slide=\"3\"] .slide-bg { background:linear-gradient(145deg, #ffe8f0 0%, #ffd6ea 100%); }\n        .slide[data-slide=\"4\"] .slide-bg { background:linear-gradient(145deg, #fff5f8 0%, #ffcce0 100%); }\n        .slide[data-slide=\"5\"] .slide-bg { background:linear-gradient(145deg, #ffe0ec 0%, #ffadd6 100%); }\n\n        /* ── Marco decorativo ── */\n        .frame {\n            position:absolute;\n            inset:16px;\n            border:5px solid rgba(255,105,180,0.35);\n            border-radius:32px;\n            z-index:1;\n            pointer-events:none;\n        }\n        .frame::before, .frame::after {\n            content:'';\n            position:absolute;\n            width:60px; height:60px;\n            border-color:#ff1493;\n            border-style:solid;\n        }\n        .frame::before { top:-5px; left:-5px; border-width:6px 0 0 6px; border-radius:8px 0 0 0; }\n        .frame::after  { bottom:-5px; right:-5px; border-width:0 6px 6px 0; border-radius:0 0 8px 0; }\n\n        /* ── Cabecera ── */\n        .slide-header {\n            position:relative;\n            z-index:5;\n            text-align:center;\n            padding-top:10px;\n        }\n\n        .slide[data-slide=\"0\"] .slide-header h1 {\n            color:#fff;\n            font-size:7rem;\n            text-shadow:0 4px 16px rgba(0,0,0,0.25);\n            letter-spacing:2px;\n        }\n        .slide[data-slide=\"0\"] .slide-header p {\n            color:rgba(255,255,255,0.9);\n            font-size:3rem;\n            margin-top:10px;\n        }\n\n        .slide-header h2 {\n            font-size:5rem;\n            color:#c71585;\n            text-shadow:3px 3px 0 #fff, 4px 4px 0 rgba(255,105,180,0.4);\n            margin-bottom:8px;\n        }\n\n        /* ── Círculo de cámara ── */\n        .cam-wrap {\n            position:relative;\n            z-index:5;\n            display:flex;\n            align-items:center;\n            justify-content:center;\n        }\n\n        .cam-wrap { display:none; }\n        .cam-wrap.activa { display:flex; }\n\n        .cam-ring {\n            position:relative;\n            width:480px;\n            height:480px;\n            border-radius:50%;\n            padding:10px;\n            background:conic-gradient(#ff1493, #ff69b4, #ffb6d9, #ff69b4, #ff1493);\n            animation:spin 8s linear infinite;\n            box-shadow:0 0 50px rgba(255,20,147,0.45), 0 0 100px rgba(255,20,147,0.2);\n        }\n\n        @keyframes spin {\n            from { transform:rotate(0deg); }\n            to   { transform:rotate(360deg); }\n        }\n\n        .cam-inner {\n            width:100%;\n            height:100%;\n            border-radius:50%;\n            overflow:hidden;\n            background:#fff0f5;\n            display:flex;\n            align-items:center;\n            justify-content:center;\n            animation:spin-reverse 8s linear infinite;\n        }\n\n        @keyframes spin-reverse {\n            from { transform:rotate(0deg); }\n            to   { transform:rotate(-360deg); }\n        }\n\n        .cam-inner img {\n            width:100%;\n            height:100%;\n            object-fit:cover;\n            border-radius:50%;\n        }\n\n\n        /* ── Pie ── */\n        .slide-footer {\n            position:relative;\n            z-index:5;\n            text-align:center;\n            padding-bottom:10px;\n        }\n\n        .slide-footer p {\n            font-size:2.8rem;\n            color:#8b3a62;\n            max-width:1100px;\n            line-height:1.5;\n            background:rgba(255,255,255,0.55);\n            border-radius:20px;\n            padding:20px 40px;\n            backdrop-filter:blur(4px);\n        }\n\n        .slide[data-slide=\"0\"] .slide-footer p {\n            color:#fff;\n            background:rgba(255,255,255,0.2);\n            font-size:3rem;\n        }\n\n        .highlight {\n            color:#ff1493;\n            font-weight:700;\n        }\n\n        /* ── Corazones flotantes ── */\n        .hearts {\n            position:absolute;\n            inset:0;\n            pointer-events:none;\n            z-index:3;\n        }\n        .h {\n            position:absolute;\n            font-size:2rem;\n            opacity:0.2;\n            animation:float 5s ease-in-out infinite;\n        }\n        @keyframes float {\n            0%,100% { transform:translateY(0) rotate(-5deg); }\n            50%      { transform:translateY(-22px) rotate(5deg); }\n        }\n\n        /* ── Contador ── */\n        .slide-counter {\n            position:fixed;\n            bottom:14px;\n            left:50%;\n            transform:translateX(-50%);\n            z-index:100;\n            display:flex;\n            align-items:center;\n            gap:6px;\n        }\n        .dot {\n            width:10px; height:10px;\n            border-radius:50%;\n            background:rgba(199,21,133,0.25);\n            transition:background 0.3s, transform 0.3s;\n            cursor:pointer;\n        }\n        .dot.active {\n            background:#ff1493;\n            transform:scale(1.35);\n        }\n\n    </style>\n</head>\n<body>\n\n<!-- Partículas de fondo -->\n<div class=\"particles\" id=\"particles\"></div>\n\n\n<div class=\"slide-container\">\n\n    <!-- SLIDE 0: Portada -->\n    <div class=\"slide active\" data-slide=\"0\">\n        <div class=\"slide-bg\"></div>\n        <div class=\"slide-header\">\n            <h1>✨ Mi Testimonio ✨</h1>\n            <p>Belén · 8 años</p>\n        </div>\n        <div class=\"cam-wrap\">\n            <div class=\"cam-ring\" id=\"ring0\">\n                <div class=\"cam-inner\" id=\"inner0\">\n                    <!-- cámara insertada por JS -->\n                </div>\n            </div>\n        </div>\n        <div class=\"slide-footer\">\n            <p>Ministerio Infantil · Iglesia</p>\n        </div>\n    </div>\n\n    <!-- SLIDE 1: Cómo conocí a Dios -->\n    <div class=\"slide\" data-slide=\"1\">\n        <div class=\"slide-bg\"></div>\n        <div class=\"frame\"></div>\n        <div class=\"hearts\">\n            <span class=\"h\" style=\"top:8%;left:9%;animation-delay:0s;\">💖</span>\n            <span class=\"h\" style=\"top:12%;right:11%;animation-delay:1.2s;\">💕</span>\n            <span class=\"h\" style=\"bottom:20%;left:7%;animation-delay:0.5s;\">💗</span>\n            <span class=\"h\" style=\"bottom:15%;right:9%;animation-delay:1.8s;\">💖</span>\n        </div>\n        <div class=\"slide-header\">\n            <h2>✨ Cómo conocí a Dios</h2>\n        </div>\n        <div class=\"cam-wrap\">\n            <div class=\"cam-ring\" id=\"ring1\">\n                <div class=\"cam-inner\" id=\"inner1\">\n                    <img id=\"cam1\" src=\"\" alt=\"cámara\" onerror=\"camError(this)\" onload=\"camOk(this)\" />\n                </div>\n            </div>\n        </div>\n        <div class=\"slide-footer\">\n            <p>En el Ministerio Infantil aprendí sobre el <span class=\"highlight\">amor de Dios</span></p>\n        </div>\n    </div>\n\n    <!-- SLIDE 2: Lo que he aprendido -->\n    <div class=\"slide\" data-slide=\"2\">\n        <div class=\"slide-bg\"></div>\n        <div class=\"frame\"></div>\n        <div class=\"hearts\">\n            <span class=\"h\" style=\"top:10%;right:14%;animation-delay:0.3s;\">💖</span>\n            <span class=\"h\" style=\"bottom:18%;left:11%;animation-delay:1.1s;\">💕</span>\n        </div>\n        <div class=\"slide-header\">\n            <h2>📖 Lo que he aprendido</h2>\n        </div>\n        <div class=\"cam-wrap\">\n            <div class=\"cam-ring\" id=\"ring2\">\n                <div class=\"cam-inner\" id=\"inner2\">\n                    <img id=\"cam2\" src=\"\" alt=\"cámara\" onerror=\"camError(this)\" onload=\"camOk(this)\" />\n                </div>\n            </div>\n        </div>\n        <div class=\"slide-footer\">\n            <p>La Biblia me enseña que <span class=\"highlight\">Dios me ama</span> y que puedo confiar en Él</p>\n        </div>\n    </div>\n\n    <!-- SLIDE 3: Mi oración -->\n    <div class=\"slide\" data-slide=\"3\">\n        <div class=\"slide-bg\"></div>\n        <div class=\"frame\"></div>\n        <div class=\"hearts\">\n            <span class=\"h\" style=\"top:9%;left:14%;animation-delay:0.7s;\">💗</span>\n            <span class=\"h\" style=\"bottom:12%;right:17%;animation-delay:0.2s;\">💖</span>\n        </div>\n        <div class=\"slide-header\">\n            <h2>🙏 Mi oración</h2>\n        </div>\n        <div class=\"cam-wrap\">\n            <div class=\"cam-ring\" id=\"ring3\">\n                <div class=\"cam-inner\" id=\"inner3\">\n                    <img id=\"cam3\" src=\"\" alt=\"cámara\" onerror=\"camError(this)\" onload=\"camOk(this)\" />\n                </div>\n            </div>\n        </div>\n        <div class=\"slide-footer\">\n            <p>Oré y <span class=\"highlight\">sentí a Dios en mi corazón</span></p>\n        </div>\n    </div>\n\n    <!-- SLIDE 4: Mi mensaje para la iglesia -->\n    <div class=\"slide\" data-slide=\"4\">\n        <div class=\"slide-bg\"></div>\n        <div class=\"frame\"></div>\n        <div class=\"hearts\">\n            <span class=\"h\" style=\"top:7%;right:7%;animation-delay:0.4s;\">💕</span>\n            <span class=\"h\" style=\"top:24%;left:9%;animation-delay:0.9s;\">💗</span>\n            <span class=\"h\" style=\"bottom:17%;right:11%;animation-delay:1.5s;\">💖</span>\n        </div>\n        <div class=\"slide-header\">\n            <h2>💒 Mi mensaje para la iglesia</h2>\n        </div>\n        <div class=\"cam-wrap\">\n            <div class=\"cam-ring\" id=\"ring4\">\n                <div class=\"cam-inner\" id=\"inner4\">\n                    <img id=\"cam4\" src=\"\" alt=\"cámara\" onerror=\"camError(this)\" onload=\"camOk(this)\" />\n                </div>\n            </div>\n        </div>\n        <div class=\"slide-footer\">\n            <p>Quiero compartirles lo que <span class=\"highlight\">Dios ha hecho en mi vida</span></p>\n        </div>\n    </div>\n\n    <!-- SLIDE 5: Gloria a Dios -->\n    <div class=\"slide\" data-slide=\"5\">\n        <div class=\"slide-bg\"></div>\n        <div class=\"frame\"></div>\n        <div class=\"hearts\">\n            <span class=\"h\" style=\"top:9%;left:11%;animation-delay:0s;\">⭐</span>\n            <span class=\"h\" style=\"top:14%;right:9%;animation-delay:0.5s;\">✨</span>\n            <span class=\"h\" style=\"bottom:14%;left:14%;animation-delay:1s;\">🌟</span>\n            <span class=\"h\" style=\"bottom:19%;right:11%;animation-delay:1.5s;\">💫</span>\n        </div>\n        <div class=\"slide-header\">\n            <h2>⭐ ¡Doy gloria a Dios!</h2>\n        </div>\n        <div class=\"cam-wrap\">\n            <div class=\"cam-ring\" id=\"ring5\">\n                <div class=\"cam-inner\" id=\"inner5\">\n                    <img id=\"cam5\" src=\"\" alt=\"cámara\" onerror=\"camError(this)\" onload=\"camOk(this)\" />\n                </div>\n            </div>\n        </div>\n        <div class=\"slide-footer\">\n            <p>Porque <span class=\"highlight\">Él cambió mi vida</span> 💝</p>\n        </div>\n    </div>\n\n</div>\n\n<!-- Contador puntos -->\n<div class=\"slide-counter\" id=\"counter\"></div>\n\n<script>\n    // ── Slides ───────────────────────────────────────────────\n    let currentSlide  = 0;\n    let transitioning = false;\n    const slides = document.querySelectorAll('.slide');\n    const total  = slides.length;\n\n    // Crear puntos\n    const counter = document.getElementById('counter');\n    for (let i = 0; i < total; i++) {\n        const d = document.createElement('div');\n        d.className = 'dot' + (i === 0 ? ' active' : '');\n        d.onclick = () => showSlide(i);\n        counter.appendChild(d);\n    }\n\n    function showSlide(n) {\n        if (n < 0 || n >= total || transitioning) return;\n        transitioning = true;\n        slides[currentSlide].classList.remove('active');\n        document.querySelectorAll('.dot')[currentSlide].classList.remove('active');\n        currentSlide = n;\n        slides[currentSlide].classList.add('active');\n        document.querySelectorAll('.dot')[currentSlide].classList.add('active');\n        setTimeout(() => { transitioning = false; }, 600);\n    }\n\n    function nextSlide() { showSlide(currentSlide + 1); }\n    function prevSlide() { showSlide(currentSlide - 1); }\n\n    document.addEventListener('keydown', e => {\n        if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ') nextSlide();\n        if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp')  prevSlide();\n    });\n\n    // ── Cámara ───────────────────────────────────────────────\n    let camStream = null;\n\n    async function activarCamara() {\n        if (camStream) return;\n        try {\n            camStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });\n            const track = camStream.getVideoTracks()[0];\n            const caps  = track.getCapabilities?.() || {};\n            if (caps.focusMode?.includes('manual'))\n                await track.applyConstraints({ advanced: [{ focusMode: 'manual' }] });\n            document.querySelectorAll('.cam-inner').forEach(el => {\n                const v = document.createElement('video');\n                v.srcObject = camStream;\n                v.autoplay = true;\n                v.muted = true;\n                v.playsInline = true;\n                v.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius:50%;';\n                el.innerHTML = '';\n                el.appendChild(v);\n            });\n            document.querySelectorAll('.cam-wrap').forEach(el => el.classList.add('activa'));\n        } catch(e) {\n            console.warn('Cámara no disponible:', e.message);\n        }\n    }\n\n    function desactivarCamara() {\n        if (camStream) { camStream.getTracks().forEach(t => t.stop()); camStream = null; }\n        document.querySelectorAll('.cam-wrap').forEach(el => el.classList.remove('activa'));\n    }\n\n    function camError(img) { img.style.display = 'none'; }\n    function camOk(img)    { img.style.display = 'block'; }\n\n    // Interfaz postMessage compatible con viewer.html\n    window.addEventListener('message', e => {\n        const d = e.data;\n        if (!d) return;\n        if (d.action === 'goto')  showSlide(d.index);\n        if (d.action === 'next')  nextSlide();\n        if (d.action === 'prev')  prevSlide();\n        if (d.action === 'load' && typeof d.index === 'number') showSlide(d.index);\n        if (d.action === 'camera') {\n            if (d.enabled) activarCamara();\n            else           desactivarCamara();\n        }\n    });\n\n    // Click para avanzar (excepto sobre controles)\n    document.addEventListener('click', e => {\n        if (e.target.closest('.cam-config, .config-panel, .dot')) return;\n        if (e.clientX > window.innerWidth / 2) nextSlide();\n        else prevSlide();\n    });\n\n    // ── Partículas ───────────────────────────────────────────\n    const emojis = ['💖','💕','💗','✨','🌸','⭐','💫','🌺'];\n    const pCont  = document.getElementById('particles');\n    for (let i = 0; i < 18; i++) {\n        const p = document.createElement('div');\n        p.className = 'particle';\n        p.textContent = emojis[i % emojis.length];\n        p.style.left     = Math.random() * 100 + '%';\n        p.style.animationDuration  = (8 + Math.random() * 10) + 's';\n        p.style.animationDelay     = (Math.random() * 12) + 's';\n        p.style.fontSize = (1.2 + Math.random() * 1.2) + 'rem';\n        pCont.appendChild(p);\n    }\n\n</script>\n</body>\n</html>\n"
}